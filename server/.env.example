NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/nestjs_db?schema=public
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

AWS_S3_PUBLIC_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_CLOUDFRONT_URL=
CDN_BASE_URL=
SEPAY_API_KEY=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Email Configuration (optional - emails will be skipped if not configured)
# For Gmail: Enable "Less secure app access" or use App Password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=

# Stripe Configuration
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4000/my-orders
STRIPE_CANCEL_URL=http://localhost:4000/my-orders

# Gemini API Key
GEMINI_API_KEY=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
