<%- include('partials/header', { title: 'Order Confirmation' }) %>

  <div class="header" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <h1>Order Confirmation</h1>
  </div>
  
  <div class="content">
    <p>Hello <strong><%= username %></strong>,</p>
    
    <p>Thank you for your order! We have received your order and it is now being processed.</p>
    
    <div class="info-box" style="background: #f9f9f9;">
      <h3 style="color: #667eea;">Order Details</h3>
      <p><strong>Order Code:</strong> <%= orderCode %></p>
      <p><strong>Payment Method:</strong> <%= paymentMethod %></p>
      <p><strong>Order Date:</strong> <%= formatDate(createdAt) %></p>
    </div>
    
    <h3 style="color: #667eea;">Items Ordered</h3>
    <table>
      <thead>
        <tr>
          <th>Item</th>
          <th class="text-right">Price</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(function(item) { %>
        <tr>
          <td><%= item.title %></td>
          <td class="text-right"><%= formatCurrency(item.price) %></td>
        </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <td><strong>Subtotal</strong></td>
          <td class="text-right"><%= formatCurrency(subTotal) %></td>
        </tr>
        <% if (totalDiscount > 0) { %>
        <tr>
          <td style="color: #e74c3c;">Discount</td>
          <td class="text-right" style="color: #e74c3c;">-<%= formatCurrency(totalDiscount) %></td>
        </tr>
        <% } %>
        <tr style="background: #f9f9f9;">
          <td><strong style="font-size: 18px;">Total</strong></td>
          <td class="text-right"><strong style="font-size: 18px; color: #667eea;"><%= formatCurrency(totalAmount) %></strong></td>
        </tr>
      </tfoot>
    </table>
    
    <div class="info-box" style="background: #fff3cd; border-left: 4px solid #ffc107;">
      <p style="margin: 0;"><strong>⚠️ Important:</strong> Please complete your payment within 24 hours to avoid order cancellation.</p>
    </div>
    
    <p style="margin-top: 30px; color: #666; font-size: 14px;">
      If you have any questions about your order, please don't hesitate to contact us.
    </p>
  </div>

<%- include('partials/footer', { companyName: companyName }) %>
