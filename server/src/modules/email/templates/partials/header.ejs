<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        line-height: 1.6;
        color: #333;
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
      }
      .header {
        padding: 30px;
        text-align: center;
        border-radius: 10px 10px 0 0;
      }
      .header h1 {
        color: white;
        margin: 0;
      }
      .content {
        background: #fff;
        padding: 30px;
        border: 1px solid #eee;
        border-top: none;
        border-radius: 0 0 10px 10px;
      }
      .info-box {
        padding: 20px;
        border-radius: 8px;
        margin: 20px 0;
      }
      .info-box h3 {
        margin-top: 0;
      }
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th {
        padding: 12px;
        text-align: left;
        background: #f5f5f5;
      }
      td {
        padding: 12px;
        border-bottom: 1px solid #eee;
      }
      .text-right {
        text-align: right;
      }
      .footer {
        text-align: center;
        padding: 20px;
        color: #999;
        font-size: 12px;
      }
    </style>
  </head>
  <body></body>
</html>
