+                                  value={field.value || ''}
+                                  disabled={isLoading || isSubmitting}
+                                />
+                              </FormControl>
+                              <FormMessage />
+                            </FormItem>
+                          )}
+                        />
+
+                        <FormField
+                          control={form.control}
+                          name="endTime"
+                          render={({ field }) => (
+                            <FormItem>
+                              <FormLabel>End Time <span className="text-red-500">*</span></FormLabel>
+                              <FormControl>
+                                <Input
+                                  {...field}
+                                  type="datetime-local"
+                                  value={field.value || ''}
+                                  disabled={isLoading || isSubmitting}
+                                />
+                              </FormControl>
+                              <FormMessage />
+                            </FormItem>
+                          )}
+                        />
+
+                        <FormField
+                          control={form.control}
+                          name="showResultDate"
+                          render={({ field }) => (
+                            <FormItem>
+                              <FormLabel>Show Result Date <span className="text-red-500">*</span></FormLabel>
+                              <FormControl>
+                                <Input
+                                  {...field}
+                                  type="datetime-local"
+                                  value={field.value || ''}
