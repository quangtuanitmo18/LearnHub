e)\n  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, courseId], name: \"unique_user_certificate\")\n  @@index([userId], map: \"idx_certificate_user\")\n  @@index([courseId], map: \"idx_certificate_course\")\n}\n\nmodel VideoNote {\n  id        String   @id @default(uuid())\n  userId    String\n  lessonId  String\n  content   String\n  timestamp Int\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)\n\n  @@index([userId, lessonId], map: \"idx_video_note_user_lesson\")\n}\n\n// ==========================================\n// GAMIFICATION MODELS\n// ==========================================\n\nmodel UserGamification {\n  id             String    @id @default(uuid())\n  userId         String    @unique\n  totalPoints    Int       @default(0)\n  currentStreak  Int       @default(0)\n  longestStreak  Int       @default(0)\n  lastActiveDate DateTime?\n  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([totalPoints(sort: Desc)], map: \"idx_gamification_points\")\n}\n\nmodel PointHistory {\n  id        String      @id @default(uuid())\n  userId    String\n  points    Int\n  reason    PointReason\n  metadata  Json? // {\"lessonId\": \"uuid\"}\n  createdAt DateTime    @default(now())\n  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@index([userId, createdAt(sort: Desc)], map: \"idx_point_history_user\")\n}\n\nmodel Badge {\n  id             String         @id @default(uuid())\n  name           String         @unique\n  description    String\n  imageUrl       String\n  conditionType  BadgeCondition\n  conditionValue Int\n  createdAt      DateTime       @default(now())\n  updatedAt      DateTime       @updatedAt\n  users       